# Template de Variables de Entorno (NO contiene claves reales)
# Copiar este archivo a .env.local y configurar con tus valores

# Nombre del Colegio para replicar fácilmente la app
VITE_NOMBRE_ESTABLECIMIENTO="Nombre de Tu Colegio Aquí"
VITE_ESTABLECIMIENTO_RBD="12345-6"

# Supabase Client Keys
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Variables compatibles con Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
