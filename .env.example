# Template de Variables de Entorno (NO contiene claves reales)
# Copiar este archivo a .env.local y configurar con tus valores

# Nombre del Colegio para replicar fácilmente la app
VITE_NOMBRE_ESTABLECIMIENTO="Nombre de Tu Colegio Aquí"
VITE_ESTABLECIMIENTO_RBD="12345-6"

# Supabase Client Keys (Públicas para Frontend / Vite)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica_aqui

# Supabase Server Key (PRIVADA - Solo para Serverless Functions / Vercel API)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada_aqui

# Configuración de Servidor SMTP (Google Gmail / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo_admin@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_google_aqui
ADMIN_EMAIL=tu_correo_admin@gmail.com
ADMIN_NAME="Nombre del Administrador"
APP_URL=https://sysget-saber.vercel.app
